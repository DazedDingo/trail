# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
pubspec.lock

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Android
android/.gradle/
android/captures/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
**/local.properties
*.jks
*.keystore
# Pinned debug keystore is the one exception — see android/app/build.gradle.kts.
# Without this negation, the wildcard above would hide it from commits and
# CI would fall back to a freshly-generated keystore per build (the bug this
# pin was added to fix).
!android/app/debug.keystore

# Gradle wrapper (regenerated by `flutter build` in CI)
gradle-wrapper.jar
android/gradlew
android/gradlew.bat

# Flutter-generated plugin registrant — `flutter pub get` recreates it.
# Checking it in creates noise on every pub upgrade.
android/app/src/main/java/io/flutter/plugins/

# iOS / macOS (not targeted, but belt-and-braces)
ios/
macos/
*.DS_Store

# OS
Thumbs.db

# App-specific — never commit these
*.mbtiles
# ...except the tiny hand-built archive fixtures the tile-server tests read
# (a few KB each; regenerate with test/fixtures/make_fixtures.py).
!test/fixtures/*.mbtiles
google-services.json

# Python tool caches (tools/coverage tests)
__pycache__/
